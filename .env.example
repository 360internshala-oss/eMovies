# eMovies environment configuration (all optional).
# Copy to `.env.local` and edit as needed. Vite only exposes VITE_* vars to the client.

# Base URL of the Filmy Flow API (no trailing slash).
VITE_API_BASE_URL=https://filmy-flow-api.vercel.app

# Set to "true" to route requests through the bundled same-origin proxy
# (`npm run proxy`, default http://localhost:8787). Needed only when the
# upstream CORS policy blocks direct browser calls.
VITE_USE_DEV_PROXY=false
VITE_PROXY_TARGET=http://localhost:8787

# Prefer the signed CDN URL over the API's /stream proxy for video playback.
VITE_PREFER_DIRECT_STREAMS=false

# Request timeout (ms) and how many catalogue pages a filter sweep may walk.
VITE_REQUEST_TIMEOUT_MS=20000
VITE_MAX_SWEEP_PAGES=6
